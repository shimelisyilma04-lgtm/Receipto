# Receipto - Production Environment Configuration
# Required:
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"
SESSION_SECRET="generate-a-64-char-random-string-for-session-signing"
NODE_ENV="production"

# Administrator Account:
ADMIN_EMAIL="admin@receipto.com"

# Owner Demo Access (Server-side Only - Verified owner email receives free demonstration access):
OWNER_DEMO_EMAIL=""
OWNER_DEMO_PLAN="growth"

# Optional Email Configuration (Resend):
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Receipto <billing@resend.dev>"

# ==============================================================================
# Paddle Billing Configuration (Live Production vs. Sandbox)
# ==============================================================================
# For Live deployment, set PADDLE_ENV="production" (or leave empty, production is default).
# For Sandbox testing, set PADDLE_ENV="sandbox".
PADDLE_ENV="production"

# Paddle API Keys:
# - Live API Key (Paddle Dashboard > Developer tools > Authentication): pdl_live_apikey_...
# - Sandbox API Key: pdl_sbox_apikey_...
PADDLE_API_KEY="pdl_live_apikey_..."

# Paddle Client-Side Token:
# - Live Client Token (Paddle Dashboard > Developer tools > Authentication): live_...
# - Sandbox Client Token: test_...
PADDLE_CLIENT_TOKEN="live_..."

# Paddle Notification Signing Secret (Webhook Signature):
# - Generated when creating Notification Destination (Paddle Dashboard > Notifications)
# - Prefix: pdl_ntfset_...
PADDLE_WEBHOOK_SECRET="pdl_ntfset_..."

# Live Paddle Price IDs (pri_...):
# Create equivalents in Paddle Live Catalog > Products & Prices
PADDLE_STARTER_MONTHLY_PRICE_ID="pri_..."
PADDLE_STARTER_YEARLY_PRICE_ID="pri_..."
PADDLE_GROWTH_MONTHLY_PRICE_ID="pri_..."
PADDLE_GROWTH_YEARLY_PRICE_ID="pri_..."

# Optional alias naming:
# PADDLE_STARTER_ANNUAL_PRICE_ID="pri_..."
# PADDLE_GROWTH_ANNUAL_PRICE_ID="pri_..."

# Application URL and Server Port:
APP_URL="https://your-domain.com"
PORT=3000

