# ==============================================================================
# RECEIPTO ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env and fill in the values for your deployment.
# All live credentials and secrets must be kept out of version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
APP_BASE_URL=https://your-domain.com
SESSION_SECRET=your-random-32-character-session-secret

# ------------------------------------------------------------------------------
# 2. FIREBASE & CLOUD FIRESTORE
# ------------------------------------------------------------------------------
# Frontend client configuration is loaded from firebase-applet-config.json.
# Admin role email for bootstrapped system administration:
ADMIN_EMAIL=admin@your-domain.com

# ------------------------------------------------------------------------------
# 3. PADDLE BILLING INTEGRATION (Paddle Billing v2)
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER=paddle
# Environment: 'sandbox' for testing, 'production' for live payments
PADDLE_ENVIRONMENT=sandbox

# Public client token (Safe for client-side Paddle.js checkout initialization):
PADDLE_CLIENT_TOKEN=test_client_token_here

# Secret API key (Server-side ONLY - used for subscription queries and management):
PADDLE_API_KEY=pdl_sct_...

# Webhook signing secret (Server-side ONLY - used for HMAC-SHA256 signature verification):
PADDLE_WEBHOOK_SECRET=pdl_ntf_set_...

# Paddle Price IDs (created in Paddle Dashboard > Catalog > Products & Prices):
PADDLE_STARTER_MONTHLY_PRICE_ID=pri_01...
PADDLE_STARTER_YEARLY_PRICE_ID=pri_01...
PADDLE_GROWTH_MONTHLY_PRICE_ID=pri_01...
PADDLE_GROWTH_YEARLY_PRICE_ID=pri_01...

# ------------------------------------------------------------------------------
# 4. EMAIL INTEGRATION (Transactional & Reminder Delivery)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_...
EMAIL_FROM=Receipto <billing@your-domain.com>
EMAIL_REPLY_TO=support@your-domain.com

# ------------------------------------------------------------------------------
# 5. DEMO & LOCAL TESTING CONTROLS (Optional)
# ------------------------------------------------------------------------------
OWNER_DEMO_EMAIL=
OWNER_DEMO_PLAN=