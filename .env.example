# ==============================================================================
# RECEIPTO ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env and fill in the values for your deployment.
# All live credentials and secrets must be kept strictly out of version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
APP_BASE_URL=https://your-domain.com
SESSION_SECRET=your-random-32-character-session-secret

# ------------------------------------------------------------------------------
# 2. FIREBASE & CLOUD FIRESTORE POWERED
# ------------------------------------------------------------------------------
# Receipto is 100% Firebase-powered (Cloud Firestore & Firebase Authentication).
# All database operations utilize Firestore multi-tenant security rules.
#
# Client configuration is loaded automatically from firebase-applet-config.json.
# Firebase Admin SDK credentials for authoritative backend operations:
# Prefer FIREBASE_SERVICE_ACCOUNT in hosted environments. For local development,
# Application Default Credentials can be supplied with GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=peta-xylopolist-hrrhs
FIRESTORE_DATABASE_ID=ai-studio-receptio-29c007e0-504b-47c8-9f48-f964bdf89cf7

# Optional local development / emulator settings (leave blank when unused).
# Set FIRESTORE_EMULATOR_HOST to host:port only when running the Firestore emulator.
FIRESTORE_EMULATOR_HOST=
GCLOUD_PROJECT=
GCP_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
# Set true only when intentionally using the in-memory development database.
USE_IN_MEMORY_FIRESTORE=false

# Administrative Superuser Email (Granted admin access in firestore.rules):
ADMIN_EMAIL=admin@your-domain.com

# ------------------------------------------------------------------------------
# 3. STRIPE PAYMENT INTEGRATION (SOLE PAYMENT PROVIDER)
# ------------------------------------------------------------------------------
# Stripe is the sole payment processor for subscriptions and customer billing.
# Obtain these credentials from your Stripe Dashboard (Developers > API keys).
# Test keys begin with 'sk_test_' and 'pk_test_'. Live keys begin with 'sk_live_' and 'pk_live_'.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs for Starter Plan (Recurring billing)
STRIPE_STARTER_MONTHLY_PRICE_ID=price_...
STRIPE_STARTER_YEARLY_PRICE_ID=price_...

# Stripe Price IDs for Growth Plan (Recurring billing)
STRIPE_GROWTH_MONTHLY_PRICE_ID=price_...
STRIPE_GROWTH_YEARLY_PRICE_ID=price_...

# ------------------------------------------------------------------------------
# 4. EMAIL INTEGRATION (RESEND TRANSACTIONAL NOTIFICATIONS)
# ------------------------------------------------------------------------------
# Resend provides transactional email delivery for account verification codes
# and client invoice payment reminders.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_...
EMAIL_FROM=Receipto <billing@your-domain.com>
RESEND_FROM_EMAIL=Receipto <billing@your-domain.com>
EMAIL_REPLY_TO=support@your-domain.com

# ------------------------------------------------------------------------------
# 5. DEMO & LOCAL TESTING CONTROLS (Optional)
# ------------------------------------------------------------------------------
# Optional local simulation overrides for development and smoke testing:
OWNER_DEMO_EMAIL=
OWNER_DEMO_PLAN=
TEST_BASE_URL=http://127.0.0.1:3000
TEST_PASSWORD=TestPassword123!
DISABLE_HMR=true
LOG_LEVEL=info