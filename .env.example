# Receipto - Production Environment Configuration
# Required:
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"
SESSION_SECRET="generate-a-64-char-random-string-for-session-signing"
NODE_ENV="production"

# Administrator Account:
ADMIN_EMAIL="admin@receipto.com"

# Optional Email Configuration (Resend):
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Receipto <billing@resend.dev>"

# Stripe Billing Configuration:
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_STARTER_MONTHLY_PRICE_ID=""
STRIPE_STARTER_YEARLY_PRICE_ID=""
STRIPE_GROWTH_MONTHLY_PRICE_ID=""
STRIPE_GROWTH_YEARLY_PRICE_ID=""
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_STARTER_ANNUAL=""
STRIPE_PRICE_GROWTH_MONTHLY=""
STRIPE_PRICE_GROWTH_ANNUAL=""

# Application URL and Server Port:
APP_URL="https://your-domain.com"
PORT=3000

