# ==============================================================================
# RECEIPTO ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env and fill in the values for your deployment.
# All live credentials and secrets must be kept strictly out of version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
APP_BASE_URL=https://your-domain.com
SESSION_SECRET=your-random-32-character-session-secret

# ------------------------------------------------------------------------------
# 2. FIREBASE & CLOUD FIRESTORE POWERED (Replaces Supabase & PostgreSQL)
# ------------------------------------------------------------------------------
# Receipto is 100% Firebase-powered (Cloud Firestore & Firebase Authentication).
# All legacy PostgreSQL database setups and Supabase dependencies have been
# completely decommissioned in favor of Cloud Firestore tenant isolation.
#
# Client configuration is loaded from firebase-applet-config.json.
# Administrative Superuser Email (Granted admin access in firestore.rules):
ADMIN_EMAIL=admin@your-domain.com

# ------------------------------------------------------------------------------
# 3. PAYMENT PROVIDERS (STRIPE & PADDLE CONFIGURABLE)
# ------------------------------------------------------------------------------
# Active provider: 'paddle' or 'stripe'
PAYMENT_PROVIDER=paddle

# --- Stripe Billing Configuration (Optional / Configurable via Environment) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_MONTHLY_PRICE_ID=price_...
STRIPE_STARTER_YEARLY_PRICE_ID=price_...
STRIPE_GROWTH_MONTHLY_PRICE_ID=price_...
STRIPE_GROWTH_YEARLY_PRICE_ID=price_...

# --- Paddle Billing v2 Configuration ---
PADDLE_ENVIRONMENT=sandbox
PADDLE_CLIENT_TOKEN=test_client_token_here
PADDLE_API_KEY=pdl_sct_...
PADDLE_WEBHOOK_SECRET=pdl_ntf_set_...
PADDLE_STARTER_MONTHLY_PRICE_ID=pri_01...
PADDLE_STARTER_YEARLY_PRICE_ID=pri_01...
PADDLE_GROWTH_MONTHLY_PRICE_ID=pri_01...
PADDLE_GROWTH_YEARLY_PRICE_ID=pri_01...

# ------------------------------------------------------------------------------
# 4. EMAIL INTEGRATION (RESEND TRANSACTIONAL NOTIFICATIONS)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_...
EMAIL_FROM=Receipto <billing@your-domain.com>
EMAIL_REPLY_TO=support@your-domain.com

# ------------------------------------------------------------------------------
# 5. DEMO & LOCAL TESTING CONTROLS (Optional)
# ------------------------------------------------------------------------------
OWNER_DEMO_EMAIL=
OWNER_DEMO_PLAN=